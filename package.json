{
  "name": "guo-intel",
  "private": true,
  "version": "0.1.2",
  "description": "Local legal intelligence workbench for Guo-related federal cases and policy monitoring.",
  "author": "Docket Observatory contributors",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/index.js",
    "dev:all": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "desktop:dev": "npm run build:native:mac && concurrently -k \"npm:dev:web\" \"wait-on http://127.0.0.1:5173 && GUO_INTEL_ELECTRON_DEV_URL=http://127.0.0.1:5173 electron electron/main.cjs\"",
    "build:native:mac": "node scripts/build-macos-keychain-addon.mjs",
    "release:prepare-native-deps:mac-arm64": "node scripts/prepare-native-packaging-deps.mjs mac-arm64",
    "release:prepare-native-deps:mac-x64": "node scripts/prepare-native-packaging-deps.mjs mac-x64",
    "release:prepare-native-deps:win-x64": "node scripts/prepare-native-packaging-deps.mjs win-x64",
    "release:prepare-data": "node scripts/prepare-release-data.mjs",
    "release:audit-research": "node scripts/research-audit.mjs",
    "release:audit-bilingual-review": "node scripts/bilingual-review-audit.mjs",
    "release:materialize-human-translations": "node scripts/materialize-human-translations.mjs",
    "release:materialize-version-locked-research": "node scripts/materialize-version-locked-research.mjs",
    "release:validate-version-locked-reviews": "node scripts/validate-version-locked-reviews.mjs",
    "release:audit-corpus-risk": "node scripts/corpus-risk-audit.mjs",
    "release:record-publication-review": "node scripts/record-publication-review.mjs",
    "release:verify-corpus-review": "node scripts/verify-corpus-review.mjs",
    "release:verify-data": "node scripts/verify-release-data.mjs",
    "release:test-seed-install": "node scripts/release-seed-install-check.mjs",
    "release:preflight:environment": "node scripts/release-environment-preflight.mjs",
    "release:preflight:mac": "node scripts/release-signing-preflight.mjs mac",
    "release:preflight:win": "node scripts/release-signing-preflight.mjs win",
    "release:preflight:community": "node scripts/community-build-config-check.mjs",
    "release:create-input-manifest": "node scripts/release-input-manifest.mjs create",
    "release:verify-input-manifest": "node scripts/release-input-manifest.mjs verify",
    "release:stage-data": "npm run release:audit-corpus-risk && npm run release:verify-corpus-review && npm run release:prepare-data && npm run release:verify-data && npm run test:public-record-transcripts && npm run test:research-chat && npm run test:automation-selection && npm run release:create-input-manifest",
    "release:verify-staged-data": "npm run release:verify-corpus-review && npm run release:verify-input-manifest && npm run release:verify-data && npm run test:public-record-transcripts && npm run test:research-chat && npm run test:automation-selection",
    "release:stage-input": "node scripts/stage-release-input.mjs stage",
    "release:cleanup-input": "node scripts/stage-release-input.mjs cleanup",
    "release:verify:mac": "node scripts/verify-macos-release.mjs release",
    "release:verify:mac:community": "node scripts/verify-macos-community-release.mjs release",
    "release:verify:win": "powershell -ExecutionPolicy Bypass -File scripts/verify-windows-release.ps1 release",
    "release:check-layout": "node scripts/release-layout-check.mjs release",
    "release:check-size": "node scripts/release-asset-size-check.mjs release",
    "release:finalize": "npm run release:check-layout && npm run release:check-size && node scripts/finalize-release-assets.mjs release",
    "test:settings": "node scripts/settings-persistence-check.mjs",
    "test:cloud-ai": "node scripts/cloud-ai-adapter-check.mjs",
    "test:ai-adapters": "node scripts/cloud-ai-adapter-check.mjs && node scripts/local-ai-adapter-check.mjs",
    "test:safe-storage": "electron scripts/electron-safe-storage-check.cjs",
    "test:safe-storage:native": "electron scripts/electron-safe-storage-check.cjs --native",
    "test:keychain:no-ui": "npm run build:native:mac && electron scripts/macos-keychain-addon-check.cjs",
    "test:credential-vault": "npm run build:native:mac && electron scripts/macos-secret-store-check.cjs",
    "test:electron-worker": "electron scripts/electron-search-worker-check.cjs",
    "desktop:dmg": "npm run release:preflight:environment && npm run release:preflight:mac && npm run release:stage-data && npm run build:native:mac && npm run build && npm run release:prepare-native-deps:mac-x64 && electron-builder --mac dmg --x64 && npm run release:prepare-native-deps:mac-arm64 && electron-builder --mac dmg --arm64 && npm run release:check-size",
    "desktop:dmg:staged": "npm run release:preflight:mac && npm run release:verify-staged-data && npm run build:native:mac && npm run build && npm run release:prepare-native-deps:mac-x64 && electron-builder --mac dmg --x64 && npm run release:prepare-native-deps:mac-arm64 && electron-builder --mac dmg --arm64 && npm run release:check-size",
    "desktop:exe": "npm run release:preflight:environment && npm run release:preflight:win && npm run release:stage-data && npm run release:prepare-native-deps:win-x64 && npm run build && electron-builder --win nsis --x64 && npm run release:check-size",
    "desktop:exe:staged": "npm run release:preflight:win && npm run release:verify-staged-data && npm run release:prepare-native-deps:win-x64 && npm run build && electron-builder --win nsis --x64 && npm run release:check-size",
    "desktop:dmg:community": "npm run release:preflight:environment && npm run release:preflight:community && npm run release:stage-data && npm run build:native:mac && npm run build && npm run release:prepare-native-deps:mac-x64 && electron-builder --config electron-builder.community.cjs --mac dmg --x64 && npm run release:prepare-native-deps:mac-arm64 && electron-builder --config electron-builder.community.cjs --mac dmg --arm64 && npm run release:verify:mac:community && npm run release:check-size",
    "desktop:dmg:community:staged": "npm run release:preflight:community && npm run release:verify-staged-data && npm run build:native:mac && npm run build && npm run release:prepare-native-deps:mac-x64 && electron-builder --config electron-builder.community.cjs --mac dmg --x64 && npm run release:prepare-native-deps:mac-arm64 && electron-builder --config electron-builder.community.cjs --mac dmg --arm64 && npm run release:verify:mac:community && npm run release:check-size",
    "desktop:exe:community": "npm run release:preflight:environment && npm run release:preflight:community && npm run release:stage-data && npm run release:prepare-native-deps:win-x64 && npm run build && electron-builder --config electron-builder.community.cjs --win nsis --x64 && npm run release:check-size",
    "desktop:exe:community:staged": "npm run release:preflight:community && npm run release:verify-staged-data && npm run release:prepare-native-deps:win-x64 && npm run build && electron-builder --config electron-builder.community.cjs --win nsis --x64 && npm run release:check-size",
    "download:docs": "node server/download-documents.js",
    "security:check": "node scripts/security-check.mjs && npm audit --audit-level=high",
    "test:zero-key": "node scripts/zero-key-defaults-check.mjs",
    "test:search:fixture": "node scripts/document-search-fixture-check.mjs",
    "test:search:corpus": "node scripts/document-search-check.mjs",
    "test:search": "node scripts/document-search-fixture-check.mjs && node scripts/document-search-check.mjs",
    "test:offline-document-read": "node scripts/document-language-quality-check.mjs && node scripts/offline-document-interpreter-check.mjs",
    "rebuild:offline-document-reads": "node scripts/rebuild-offline-document-reads.mjs",
    "repair:document-language": "node scripts/repair-document-analysis-language.mjs",
    "test:relationships": "node scripts/relationship-graph-check.mjs",
    "test:public-records": "node scripts/public-record-check.mjs",
    "import:public-record-transcripts": "node scripts/import-public-record-transcripts.mjs",
    "audit:public-record-subtitles": "node scripts/import-public-record-transcripts.mjs --refresh-public-subtitles --audit-all-public-subtitles --concurrency=6 --delay-ms=80",
    "audit:community-transcripts": "node scripts/import-public-record-transcripts.mjs --refresh-community-transcripts --force-community-transcripts --concurrency=6 --delay-ms=80",
    "audit:legacy-transcripts": "node scripts/import-public-record-transcripts.mjs --refresh-legacy-transcripts --concurrency=6 --delay-ms=80",
    "audit:public-posts": "node scripts/import-public-record-transcripts.mjs --refresh-public-posts --concurrency=6 --delay-ms=80",
    "audit:notebook-transcript-bundle": "node scripts/notebook-transcript-bundle-check.mjs",
    "audit:bearblog-transcripts": "node scripts/bearblog-transcript-audit.mjs",
    "audit:gwins-transcript-gaps": "node scripts/gwins-transcript-gap-audit.mjs",
    "merge:full-public-transcripts": "node scripts/merge-full-public-transcripts.mjs",
    "translate:public-record-transcripts:en": "node scripts/translate-public-record-transcripts-en.mjs",
    "translate:public-record-transcripts:en:fast": "node scripts/translate-public-record-transcripts-fast.mjs",
    "translate:public-record-transcripts:en:fast:start": "node scripts/start-fast-transcript-translation.mjs",
    "translate:public-record-transcripts:en:retry-failures": "node scripts/retry-failed-public-record-translations.mjs",
    "translate:public-record-transcripts:en:retry-failures:start": "node scripts/start-public-record-translation-retry.mjs",
    "repair:public-record-translations:en:markers": "node scripts/repair-public-record-translation-markers.mjs",
    "repair:public-record-translations:en:glossary": "node scripts/repair-public-record-translation-glossary.mjs --deterministic",
    "repair:public-record-translations:en:glossary:model": "node scripts/repair-public-record-translation-glossary.mjs",
    "repair:public-record-translations:en:case": "node scripts/repair-public-record-translation-case.mjs",
    "repair:public-record-translations:en:names": "node scripts/repair-public-record-translation-source-names.mjs",
    "translate:public-record-transcripts:en:local": "node scripts/run-local-transcript-translation-to-completion.mjs",
    "translate:public-record-transcripts:en:start": "node scripts/start-local-transcript-translation.mjs",
    "translate:public-record-transcripts:en:status": "node scripts/transcript-translation-status.mjs",
    "audit:all-transcripts": "node scripts/import-public-record-transcripts.mjs --refresh-community-transcripts --force-community-transcripts --refresh-legacy-transcripts --refresh-public-posts --concurrency=6 --delay-ms=80",
    "import:ghot-text-archive": "node scripts/import-ghot-text-archive.mjs",
    "test:ghot-text-archive": "node scripts/ghot-text-archive-check.mjs",
    "test:public-record-transcripts": "node scripts/public-record-transcript-check.mjs && node scripts/public-record-transcript-corpus-check.mjs",
    "test:research-chat": "node scripts/research-chat-history-check.mjs && node scripts/ghot-text-archive-check.mjs && node scripts/research-chat-check.mjs",
    "test:automation-selection": "node scripts/automation-selection-check.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
    "build": {
    "appId": "org.docketobservatory.app",
    "productName": "案卷观察台",
    "forceCodeSigning": true,
    "compression": "maximum",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "!server/cache/**",
      "!server/**/*.log",
      "electron/**/*",
      "package.json",
      "build/icon.icns"
    ],
    "extraResources": [
      {
        "from": "downloads/court-files-complete",
        "to": "court-files",
        "filter": [
          "**/*.pdf",
          "integrity-history.jsonl"
        ]
      },
      {
        "from": "release-metadata/corpus-manifest.json",
        "to": "court-files/manifest.json"
      },
      {
        "from": "release-data/seed-cache",
        "to": "seed-cache",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "release-metadata/seed-cache-manifest.json",
        "to": "seed-cache-manifest.json"
      },
      {
        "from": "electron",
        "to": "startup",
        "filter": [
          "startup.html",
          "startup-error.html",
          "startup-error.js"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.reference",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "notarize": true,
      "extraResources": [
        {
          "from": "build/native/${arch}/docket-observatory-keychain.node",
          "to": "native/docket-observatory-keychain.node"
        }
      ],
      "artifactName": "Docket-Observatory-${version}-macOS-${arch}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Docket-Observatory-${version}-Windows-${arch}.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "案卷观察台"
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.7",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "lucide-react": "^1.32.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.4",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "tar": "7.5.22",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
